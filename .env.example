# Backend API base URL (no trailing slash)
# Examples:
#   Local:      http://localhost:9520/api
#   Staging:    https://api-staging.example.com/api
#   Production: https://api.example.com/api
VITE_API_BASE_URL=http://localhost:9520/api

# App
VITE_APP_NAME=Fleet
